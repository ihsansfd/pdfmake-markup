{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run Sample",
      "program": "${workspaceFolder}/sample-runner.js",
      "args": ["sample-query-with-params"],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Current File",
      "program": "${workspaceFolder}/sample-runner.js",
      "args": ["${file}"],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Sample (Pick File)",
      "program": "${workspaceFolder}/sample-runner.js",
      "args": ["${input:pdfmkFile}"],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Tests",
      "program": "${workspaceFolder}/node_modules/.bin/vitest",
      "args": ["run"],
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "pdfmkFile",
      "type": "promptString",
      "description": "Name of the .pdfmk file (without extension)"
    }
  ]
}
