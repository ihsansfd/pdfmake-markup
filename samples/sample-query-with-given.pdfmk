{
	pageMargins: [40, 40, 40, 60],
	footer:
		given(currentPage, pageCount) {
			text: %{var:footerPrefix}%,
			alignment: 'center',
			margin: [0, 20, 0, 0]
		},
	content: [
		{ text: %{var:title}%, style: 'header' },
		%{var:subtitle}%,
		'',
		{
			style: 'tableExample',
			table: {
				headerRows: 1,
				widths: [100, '*', 80],
				heights:
					given(row) {
						%{(row + 1) * 25}%
					},
				body: [
					[
						{ text: 'Item', style: 'tableHeader' },
						{ text: 'Description', style: 'tableHeader' },
						{ text: 'Price', style: 'tableHeader' }
					],
					['Widget', 'A very fine widget', '$25.00'],
					['Gadget', 'A handy gadget', '$15.00'],
					['Doohickey', 'An essential doohickey', '$35.00']
				]
			},
			layout: {
				hLineWidth:
					given(i, node) {
						%{(i == 0 || i == (node.table.body|length)) ? 2 : 1}%
					},
				hLineColor:
					given(i, node) {
						%{(i == 0 || i == (node.table.body|length)) ? "black" : "gray"}%
					},
				fillColor:
					given(rowIndex, node, columnIndex) {
						%{rowIndex % 2 == 0 ? "#f5f5f5" : "white"}%
					}
			}
		}
	],
	styles: {
		header: {
			fontSize: 22,
			bold: true,
			margin: [0, 0, 0, 10]
		},
		tableExample: {
			margin: [0, 5, 0, 15]
		},
		tableHeader: {
			bold: true,
			fontSize: 13,
			color: 'black'
		}
	}
}
