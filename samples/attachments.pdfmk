{
  // This sample embeds local repo files so it stays renderable offline.
  content: [
    { text: 'Attachments Demo', style: 'header' },
    'Each listed file is generated via a `map` over inline data.',
    ' ',

    ...map(file in %{[
      {
        label: "Project README",
        name: "README.md",
        src: "README.md",
        description: "The published package overview and language guide."
      },
      {
        label: "Package manifest",
        name: "package.json",
        src: "package.json",
        description: "Package metadata used for npm publishing."
      }
    ]}%) {
      {
        stack: [
          { text: %{"• " + file.label}%, bold: true, margin: [0, 6, 0, 2] },
          if(%{file.description}%) {
            { text: %{file.description}%, fontSize: 9, italics: true, color: '#666' }
          } else {
            { text: '(no description)', fontSize: 9, italics: true, color: '#999' }
          },
          { text: %{"source: " + file.src}%, fontSize: 8, color: '#888' }
        ],
        margin: [0, 0, 0, 8]
      }
    }
  ],
  attachments: {
    "README.md":    { src: "README.md",    name: "README.md" },
    "package.json": { src: "package.json", name: "package.json" }
  },
  styles: {
    header: { fontSize: 18, bold: true, margin: [0, 0, 0, 10] }
  }
}
