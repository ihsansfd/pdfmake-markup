{%- set extraParagraphs = [
  'Paragraph 3 — supplied via sample vars.',
  'Paragraph 4 — looped via `for`.',
  'Paragraph 5 — no manual repetition needed.'
] -%}
{%- set showFooter = true -%}
{
  content: [
    'First paragraph',
    'Another paragraph, this time a little bit longer to make sure, this line will be divided into at least two lines',

    // Demonstrate `for` producing a sequence of paragraphs from data
    for(p in %{ {{ extraParagraphs }} }%) {
      { text: %{p}%, margin: [0, 4, 0, 0] }
    },

    // Demonstrate `if` dropping content when condition is false
    if(%{ {{ showFooter }} }%) {
      { text: 'Generated by pdfmake-markup', italics: true, color: 'gray', margin: [0, 10, 0, 0] }
    }
  ]
}
