{
  content: [
    { text: 'Snaking Columns Demo', style: 'header' },
    { text: 'The snakingColumns: true property allows content to flow from one column to the next on the same page.', style: 'description' },
    ' ',

    // Basic snaking column with repeated lorem text
    {
      columns: [
        { text: %{loremShort}%, width: '*' },
        { text: '', width: '*' }
      ],
      columnGap: 30,
      snakingColumns: true
    },

    { text: 'Content After Snaking Columns', style: 'subheader', margin: [0, 10, 0, 5] },
    { text: 'Demonstrates that layout tracks the bottom of snaking content correctly.', style: 'description' },
    ' ',

    // Generate 80 lines via `for` — previously required a JS helper function.
    { text: 'Detailed Description (80 generated lines via `for`)', style: 'sectionTitle', pageBreak: 'before' },
    {
      columns: [
        {
          stack: [
            for(i in %{var:lineCount}%) {
              { text: %{"Line " + (i + 1) + ": Lorem ipsum dolor sit amet."}%, fontSize: 9 }
            }
          ]
        },
        { text: '' }
      ],
      columnGap: 30,
      snakingColumns: true
    },

    // Text nodes via `for` + conditional margin on first/last using $index/$length
    { text: 'Stack of text nodes (with $index/$length awareness)', style: 'sectionTitle', pageBreak: 'before' },
    {
      columns: [
        {
          stack: [
            for(i in %{var:textNodeCount}%) {
              {
                text: %{"Item " + (i + 1) + " — a description"}%,
                margin: [
                  0,
                  %{i::index == 0 ? 0 : 5}%,
                  0,
                  %{i::index == i::length - 1 ? 0 : 5}%
                ]
              }
            }
          ],
          width: '*'
        },
        { text: '', width: '*' }
      ],
      columnGap: 20,
      snakingColumns: true
    },

    // Unbreakable cards via `for` — previously a dedicated JS helper
    { text: 'Unbreakable Cards (via `for`, each marked unbreakable)', style: 'header', pageBreak: 'before' },
    { text: 'Each card stays together when flowing between columns.', style: 'description' },
    ' ',
    {
      columns: [
        {
          stack: [
            for(i in %{var:cardCount}%) {
              {
                stack: [
                  { text: %{"Card " + (i + 1)}%, fontSize: 14, bold: true, margin: [0, 0, 0, 5] },
                  { text: %{"This is a description for card " + (i + 1) + ". All content in this card stays together."}%, fontSize: 10 },
                  if(%{i < 5}%) {
                    { text: 'Status: Featured', fontSize: 9, color: '#c0392b', margin: [0, 5, 0, 0] }
                  } else {
                    { text: 'Status: Active', fontSize: 9, color: '#666', margin: [0, 5, 0, 0] }
                  }
                ],
                margin: [0, 0, 0, 10],
                fillColor: '#f9f9f9',
                unbreakable: true
              }
            }
          ]
        },
        { text: '' }
      ],
      columnGap: 30,
      snakingColumns: true
    },

    // Dynamic table inside snaking columns — header + N rows via for.
    { text: 'Generated Table inside Snaking Columns', style: 'header', pageBreak: 'before' },
    ' ',
    {
      columns: [
        {
          table: {
            headerRows: 1,
            body: [
              ['Header 1', 'Header 2', 'Header 3'],
              for(i in %{var:tableRowCount}%) {
                [%{"Row " + (i + 1)}%, 'Column 2', 'Column 3']
              }
            ]
          },
          width: '*'
        },
        { text: '', width: '*' }
      ],
      columnGap: 30,
      snakingColumns: true
    }
  ],
  styles: {
    header: { fontSize: 18, bold: true, margin: [0, 0, 0, 10] },
    subheader: { fontSize: 14, bold: true, margin: [0, 10, 0, 5] },
    sectionTitle: { fontSize: 12, bold: true, color: '#2c3e50', margin: [0, 0, 0, 8] },
    description: { fontSize: 10, italics: true, color: '#666', margin: [0, 0, 0, 5] }
  }
}
